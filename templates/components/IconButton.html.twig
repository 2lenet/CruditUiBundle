{#
 # Button with an icon only. The label is its accessible name, read but not shown: put the count in it.
 #
 # Props: icon, label (required), size (md, small), href, type (button), disabled, loading, count (shown on the
 # corner of the icon, hidden from assistive technologies). Contract: docs/components.md.
 #}
{% props icon, label, size = 'md', href = null, type = 'button', disabled = false, loading = false, count = null %}
{#- The attributes go through defaults(), as in Button. -#}
{%- set defaults = {
    class: 'crudit-ui-icon-btn' ~ (size == 'small' ? ' crudit-ui-icon-btn--small' : '') ~ (count is not null ? ' crudit-ui-icon-btn--with-count' : ''),
    'data-controller': '2lenet--crudit-ui-bundle--button',
} -%}
{%- if href is not null and disabled -%}
    {%- set defaults = defaults|merge({role: 'link', 'aria-disabled': 'true'}) -%}
{%- endif -%}
{%- if loading -%}
    {%- set defaults = defaults|merge({'aria-disabled': 'true', 'aria-busy': 'true'}) -%}
{%- endif -%}
{%- if href is not null -%}
    <a {% if not disabled %}href="{{ href }}" {% endif %}{{ attributes.defaults(defaults) }}>
{%- else -%}
    <button type="{{ type }}"{% if disabled %} disabled{% endif %} {{ attributes.defaults(defaults) }}>
{%- endif -%}
    {{- ui_icon(loading ? 'loading' : icon) -}}
    <span class="crudit-ui-visually-hidden">{{ label }}</span>
    {%- if count is not null %}<span class="crudit-ui-icon-btn__count" aria-hidden="true">{{ count }}</span>{% endif -%}
{%- if href is not null %}</a>{% else %}</button>{% endif -%}
