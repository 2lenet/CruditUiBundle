{#
 # Dropdown: a button that opens a panel (controller dropdown). Disclosure pattern, not an ARIA menu: the panel holds a
 # Menu, links, buttons or fields; Tab goes from one to the next, Escape closes it and gives the focus back to the
 # button, a click outside or the focus leaving it close it, the choice of an item of a Menu closes it.
 #
 # Props: label (required: text of the button, or its accessible name with iconOnly), icon, iconOnly (an IconButton,
 # "more" by default), variant (as Button; secondary), size (md, small), align (end, start: edge of the button the
 # panel is aligned on), floating (position: fixed, inside a table or a container that scrolls). The button is in
 # loading while an item of the panel sends a form.
 # Blocks: content (the panel), trigger (the content of the button, in place of icon, label and chevron).
 # Attributes: on the root; `trigger:` on the button, `panel:` on the panel. The id passed by the project, if any,
 # names the panel too (<id>-panel). Contract: docs/components.md.
 #}
{% props label, icon = null, iconOnly = false, variant = 'secondary', size = 'md', align = 'end', floating = false %}
{%- set id = attributes.render('id') ?? ('crudit-ui-dropdown-' ~ random()) -%}
{%- set controller = '2lenet--crudit-ui-bundle--dropdown' -%}
{%- set root = {class: 'crudit-ui-dropdown', 'data-controller': controller} -%}
{%- if floating %}{% set root = root|merge({('data-' ~ controller ~ '-floating-value'): 'true'}) %}{% endif -%}
{%- if align != 'end' %}{% set root = root|merge({('data-' ~ controller ~ '-align-value'): align}) %}{% endif -%}
{%- if iconOnly -%}
    {%- set class = 'crudit-ui-icon-btn' ~ (size == 'small' ? ' crudit-ui-icon-btn--small' : '') -%}
{%- else -%}
    {%- set class = 'crudit-ui-btn crudit-ui-btn--' ~ variant ~ (size == 'small' ? ' crudit-ui-btn--small' : '') -%}
{%- endif -%}
<div id="{{ id }}" {{ attributes.defaults(root) }}>
    {{- include('@LleCruditUi/partials/_button_open.html.twig', {attributes: attributes.nested('trigger'), class: class, href: null, type: 'button', disabled: false, loading: false, busyOnSubmit: false, extra: {
        'aria-expanded': 'false',
        'aria-controls': id ~ '-panel',
        ('data-' ~ controller ~ '-target'): 'button',
        'data-action': controller ~ '#toggle',
    }}, with_context: false) -}}
        {#- Spinner of the loading state, while an item of the panel sends a form (controllers dropdown and button). It
         # takes the place of the first svg child of the button: the icon, or the chevron when there is none. Keep
         # this order if the button is reordered. -#}
        <template data-2lenet--crudit-ui-bundle--button-target="spinner">{{ ui_icon('loading') }}</template>
        {%- block trigger -%}
            {%- if iconOnly -%}
                {{- ui_icon(icon ?? 'more') -}}<span class="crudit-ui-visually-hidden">{{ label }}</span>
            {%- else -%}
                {%- if icon %}{{ ui_icon(icon) }}{% endif -%}
                {{- label -}}
                {{- ui_icon('dropdown', 'crudit-ui-dropdown__chevron') -}}
            {%- endif -%}
        {%- endblock -%}
    </button>
    <div id="{{ id }}-panel" hidden {{ attributes.nested('panel').defaults({
        class: 'crudit-ui-dropdown__panel' ~ (align == 'start' ? ' crudit-ui-dropdown__panel--start' : '') ~ (floating ? ' crudit-ui-dropdown__panel--floating' : ''),
        ('data-' ~ controller ~ '-target'): 'panel',
    }) }}>
        {%- block content %}{% endblock -%}
    </div>
</div>
