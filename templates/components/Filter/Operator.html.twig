{#
 # Filter:Operator: the condition of a filter (is, is not, contains, before…), a pictogram in front of the input that
 # opens the list of the conditions (pictogram and label in plain words). A Dropdown holding radio buttons: the chosen
 # one is what the form sends (`<name>_op`), without any script. The button is named "Condition for <label>:
 # <condition>". The controller filter-field keeps the pictogram and the name of the button in step with the choice.
 #
 # Props: name (required: name of the radios, `<name>_op`), label (required: the label of the filter), operators
 # (required: list of {value, label, icon, noValue}), current (value of the chosen one, the first by default),
 # id (base of the ids, random otherwise). Contract: docs/components.md.
 #}
{% props name, label, operators, current = null, id = null %}
{%- set base = id ?? ('crudit-ui-operator-' ~ random()) -%}
{%- set filterLabel = label -%}
{%- set chosen = current ?? (operators|first).value -%}
{%- set selected = operators|filter(operator => operator.value == chosen)|first ?: (operators|first) -%}
<div {{ attributes.defaults({class: 'crudit-ui-operator'}) }}>
    <twig:LleCruditUi:Dropdown id="{{ base }}" label="{{ 'crudit_ui.filter.operator_for'|trans({'%label%': filterLabel, '%operator%': selected.label}, 'LleCruditUiBundle') }}" size="small" align="start" floating>
        <twig:block name="trigger">
            <span class="crudit-ui-operator__icon" data-2lenet--crudit-ui-bundle--filter-field-target="operatorIcon">{{ ui_icon(selected.icon) }}</span>
            {{- ui_icon('dropdown', 'crudit-ui-operator__chevron') -}}
            <span class="crudit-ui-visually-hidden" data-2lenet--crudit-ui-bundle--filter-field-target="operatorName">{{ 'crudit_ui.filter.operator_for'|trans({'%label%': filterLabel, '%operator%': selected.label}, 'LleCruditUiBundle') }}</span>
        </twig:block>
        <fieldset class="crudit-ui-operator__options">
            <legend class="crudit-ui-visually-hidden">{{ 'crudit_ui.filter.operator_legend'|trans({'%label%': filterLabel}, 'LleCruditUiBundle') }}</legend>
            {% for operator in operators %}
                <label class="crudit-ui-operator__option">
                    <input class="crudit-ui-operator__radio" type="radio" name="{{ name }}_op" value="{{ operator.value }}"
                        {{- operator.value == selected.value ? ' checked' : '' }}
                        data-no-value="{{ operator.noValue|default(false) ? 'true' : 'false' }}"
                        data-name="{{ 'crudit_ui.filter.operator_for'|trans({'%label%': filterLabel, '%operator%': operator.label}, 'LleCruditUiBundle') }}"
                        data-action="2lenet--crudit-ui-bundle--filter-field#choose">
                    {{- ui_icon(operator.icon, 'crudit-ui-operator__option-icon') -}}
                    <span>{{ operator.label }}</span>
                </label>
            {% endfor %}
        </fieldset>
    </twig:LleCruditUi:Dropdown>
</div>
