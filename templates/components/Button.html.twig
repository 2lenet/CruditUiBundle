{#
 # Button, or link that looks like a button (`href`). One primary button per zone.
 #
 # Props: variant (primary, secondary, ghost, warning, danger, danger-outline, link; secondary), size (md, small),
 # icon (logical or Iconify name, before the label), href, type (button), disabled, loading, count, busyOnSubmit
 # (true for a submit button: loading once it sends its form).
 # Block: content (the label). Contract: docs/components.md.
 #}
{% props variant = 'secondary', size = 'md', icon = null, href = null, type = 'button', disabled = false, loading = false, count = null, busyOnSubmit = null %}
{%- set busyOnSubmit = busyOnSubmit ?? (type == 'submit') -%}
{%- set icon = loading ? 'loading' : icon -%}
{%- set class = 'crudit-ui-btn crudit-ui-btn--' ~ variant ~ (size == 'small' ? ' crudit-ui-btn--small' : '') -%}
{{- include('@LleCruditUi/partials/_button_open.html.twig') -}}
    {%- if icon %}{{ ui_icon(icon) }}{% endif -%}
    {%- block content %}{% endblock -%}
    {%- if count is not null %}<span class="crudit-ui-btn__count">{{ count }}</span>{% endif -%}
{%- if href is not null %}</a>{% else %}</button>{% endif -%}
