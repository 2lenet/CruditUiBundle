{#
 # Boolean value: an icon and Yes or No, written. Null: a dash, read as "Not set".
 #
 # Props: value (true, false or null), yes, no (the labels; translated Yes and No by default).
 # Contract: docs/components.md.
 #}
{% props value = null, yes = null, no = null %}
{%- if value is null -%}
    <span {{ attributes.defaults({class: 'crudit-ui-empty-value'}) }}><span aria-hidden="true">—</span><span class="crudit-ui-visually-hidden">{{ 'crudit_ui.value.empty'|trans(domain: 'LleCruditUiBundle') }}</span></span>
{%- elseif value -%}
    <span {{ attributes.defaults({class: 'crudit-ui-bool crudit-ui-bool--yes'}) }}>{{ ui_icon('check') }}{{ yes ?? 'crudit_ui.boolean.yes'|trans(domain: 'LleCruditUiBundle') }}</span>
{%- else -%}
    <span {{ attributes.defaults({class: 'crudit-ui-bool crudit-ui-bool--no'}) }}>{{ ui_icon('close') }}{{ no ?? 'crudit_ui.boolean.no'|trans(domain: 'LleCruditUiBundle') }}</span>
{%- endif -%}
