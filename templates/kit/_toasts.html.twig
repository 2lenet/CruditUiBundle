{# Toasts (1.5.e): the region of the kit, filled by the links (?toast=), as the flash messages after a redirect; the four tones shown in place. #}
{%- set messages = {
    success: {tone: 'success', text: 'The visit V-0412 is saved.'},
    info: {tone: 'info', text: 'The export has started: you will be told when it is ready.'},
    warning: {tone: 'warning', text: 'The visit is saved, but its planned date is 5 days late.'},
    danger: {tone: 'danger', text: 'The server refused the record. Try again later.'},
} -%}
{%- set requested = app.request.query.get('toast') -%}
{%- set shown = requested == 'all' ? [messages.danger, messages.success, messages.info, messages.warning, messages.success] : (messages[requested] is defined ? [messages[requested]] : []) -%}
<p class="crudit-ui-kit__text">Messages on the result of an action, on the top inline end side. They are read when they appear (an error at once). Success, information and warning go after 6 seconds, paused while the pointer or the focus is on them; an error stays until it is closed. Four at most: beyond, the oldest that is not an error goes.</p>

<h3 class="crudit-ui-kit__subtitle">Show a message</h3>
<p class="crudit-ui-kit__text">The page is loaded again with the message, as a flash message after a redirect.</p>
<div class="crudit-ui-kit__row">
    <twig:LleCruditUi:Button href="?toast=success#kit-toasts" icon="success">Success</twig:LleCruditUi:Button>
    <twig:LleCruditUi:Button href="?toast=info#kit-toasts" icon="info">Information</twig:LleCruditUi:Button>
    <twig:LleCruditUi:Button href="?toast=warning#kit-toasts" icon="warning">Warning</twig:LleCruditUi:Button>
    <twig:LleCruditUi:Button href="?toast=danger#kit-toasts" icon="error">Error</twig:LleCruditUi:Button>
    <twig:LleCruditUi:Button href="?toast=all#kit-toasts">Five messages</twig:LleCruditUi:Button>
</div>

<twig:LleCruditUi:Toasts id="kit-toasts-region">
    {%- for message in shown -%}
        <twig:LleCruditUi:Toast tone="{{ message.tone }}">{{ message.text }}</twig:LleCruditUi:Toast>
    {%- endfor -%}
</twig:LleCruditUi:Toasts>

<h3 class="crudit-ui-kit__subtitle">Shown in place</h3>
<p class="crudit-ui-kit__text">The same component out of the region: neither read nor removed (the kit only).</p>
<div class="crudit-ui-kit__stack crudit-ui-kit__toasts">
    {%- for message in messages -%}
        <twig:LleCruditUi:Toast tone="{{ message.tone }}">{{ message.text }}</twig:LleCruditUi:Toast>
    {%- endfor -%}
</div>
