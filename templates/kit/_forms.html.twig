{%- set kit_photo = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 48"><rect width="64" height="48" fill="#dbeafe"/><rect x="10" y="18" width="44" height="26" fill="#1e40af"/><rect x="26" y="28" width="12" height="16" fill="#fff"/></svg>' -%}
<form class="crudit-ui-kit__columns" novalidate>
    <div class="crudit-ui-kit__stack">
        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-name" class="crudit-ui-label">Customer<span class="crudit-ui-required" aria-hidden="true">&nbsp;*</span></label>
                <twig:LleCruditUi:Toggletip label="Help on the field Customer" id="kit-form-name-tip">The name <b>on the invoice</b>.</twig:LleCruditUi:Toggletip>
            </div>
            <input type="text" id="kit-form-name" class="crudit-ui-input" required aria-describedby="kit-form-name_help" value="Martin SA">
            <div id="kit-form-name_help" class="crudit-ui-help">As on the purchase order</div>
        </div>

        <div class="crudit-ui-field crudit-ui-field--invalid">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-phone" class="crudit-ui-label">Phone of the contact<span class="crudit-ui-required" aria-hidden="true">&nbsp;*</span></label>
            </div>
            <input type="tel" id="kit-form-phone" class="crudit-ui-input" required aria-invalid="true" aria-describedby="kit-form-phone_error" value="06 12">
            <p id="kit-form-phone_error" class="crudit-ui-error">{{ ui_icon('error') }}<span>Enter a number of 10 digits, for example 06 12 34 56 78.</span></p>
        </div>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-kind" class="crudit-ui-label">Kind<span class="crudit-ui-required" aria-hidden="true">&nbsp;*</span></label>
            </div>
            <select id="kit-form-kind" class="crudit-ui-select" required>
                <option value="" disabled selected>Choose…</option>
                <option>Maintenance</option>
                <option>Repair</option>
            </select>
        </div>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-amount" class="crudit-ui-label">Amount</label>
            </div>
            <div class="crudit-ui-input-group">
                <input type="text" inputmode="decimal" id="kit-form-amount" class="crudit-ui-input" aria-describedby="kit-form-amount_unit" value="1 250,00">
                <span id="kit-form-amount_unit" class="crudit-ui-input-group__unit">€</span>
            </div>
        </div>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-disabled" class="crudit-ui-label">Number</label>
            </div>
            <input type="text" id="kit-form-disabled" class="crudit-ui-input" disabled value="INT-2026-0412">
        </div>
    </div>

    <div class="crudit-ui-kit__stack">
        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-notes" class="crudit-ui-label">Notes</label>
            </div>
            <textarea id="kit-form-notes" class="crudit-ui-input crudit-ui-textarea" maxlength="80" aria-describedby="kit-form-notes_count"
                data-controller="2lenet--crudit-ui-bundle--char-count"
                data-2lenet--crudit-ui-bundle--char-count-locale-value="{{ (app.request.locale ?? '')|replace({'_': '-'}) }}"
                data-2lenet--crudit-ui-bundle--char-count-one-value="{{ 'crudit_ui.form.count.one'|trans({'%count%': 80}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-many-value="{{ 'crudit_ui.form.count.many'|trans({'%count%': 80}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-left-one-value="{{ 'crudit_ui.form.count.left_one'|trans({}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-left-many-value="{{ 'crudit_ui.form.count.left_many'|trans({}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-full-value="{{ 'crudit_ui.form.count.full'|trans({}, 'LleCruditUiBundle') }}">Back door</textarea>
            <p id="kit-form-notes_count" class="crudit-ui-field__count">
                <span data-crudit-ui-count>{{ 'crudit_ui.form.count.many'|trans({'%length%': 9, '%count%': 80}, 'LleCruditUiBundle') }}</span>
            </p>
            <span id="kit-form-notes_count_live" class="crudit-ui-visually-hidden" aria-live="polite" data-crudit-ui-count-live></span>
        </div>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-memo" class="crudit-ui-label">Memo (near the limit when loaded)</label>
            </div>
            <textarea id="kit-form-memo" class="crudit-ui-input crudit-ui-textarea" maxlength="80" aria-describedby="kit-form-memo_count"
                data-controller="2lenet--crudit-ui-bundle--char-count"
                data-2lenet--crudit-ui-bundle--char-count-locale-value="{{ (app.request.locale ?? '')|replace({'_': '-'}) }}"
                data-2lenet--crudit-ui-bundle--char-count-one-value="{{ 'crudit_ui.form.count.one'|trans({'%count%': 80}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-many-value="{{ 'crudit_ui.form.count.many'|trans({'%count%': 80}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-left-one-value="{{ 'crudit_ui.form.count.left_one'|trans({}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-left-many-value="{{ 'crudit_ui.form.count.left_many'|trans({}, 'LleCruditUiBundle') }}"
                data-2lenet--crudit-ui-bundle--char-count-full-value="{{ 'crudit_ui.form.count.full'|trans({}, 'LleCruditUiBundle') }}">Ring twice at the back door, the bell at the front does not work since last we</textarea>
            <p id="kit-form-memo_count" class="crudit-ui-field__count">
                <span data-crudit-ui-count>{{ 'crudit_ui.form.count.many'|trans({'%length%': 78, '%count%': 80}, 'LleCruditUiBundle') }}</span>
            </p>
            <span id="kit-form-memo_count_live" class="crudit-ui-visually-hidden" aria-live="polite" data-crudit-ui-count-live></span>
        </div>

        <fieldset class="crudit-ui-field crudit-ui-field__group">
            <legend class="crudit-ui-label">Size</legend>
            <div id="kit-form-size" class="crudit-ui-segmented">
                <label class="crudit-ui-segmented__option"><input type="radio" name="kit-form-size" class="crudit-ui-segmented__input" value="s"><span class="crudit-ui-segmented__label">Small</span></label>
                <label class="crudit-ui-segmented__option"><input type="radio" name="kit-form-size" class="crudit-ui-segmented__input" value="m" checked><span class="crudit-ui-segmented__label">Medium</span></label>
                <label class="crudit-ui-segmented__option"><input type="radio" name="kit-form-size" class="crudit-ui-segmented__input" value="l"><span class="crudit-ui-segmented__label">Large</span></label>
            </div>
        </fieldset>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-tint" class="crudit-ui-label">Colour</label>
            </div>
            <div class="crudit-ui-input-group crudit-ui-input-group--color">
                <input type="color" id="kit-form-tint" class="crudit-ui-input" value="#1e40af" data-controller="2lenet--crudit-ui-bundle--color-code">
                <span class="crudit-ui-input-group__unit" aria-hidden="true" data-color-code>#1e40af</span>
            </div>
        </div>

        <fieldset class="crudit-ui-field crudit-ui-field__group">
            <legend class="crudit-ui-label">Delivery date (inputs)</legend>
            <div id="kit-form-delivery" class="crudit-ui-date-lists">
                <input type="text" id="kit-form-delivery_day" class="crudit-ui-input" inputmode="numeric" aria-label="{{ 'crudit_ui.form.date.day'|trans({}, 'LleCruditUiBundle') }}" value="24">/<input type="text" id="kit-form-delivery_month" class="crudit-ui-input" inputmode="numeric" aria-label="{{ 'crudit_ui.form.date.month'|trans({}, 'LleCruditUiBundle') }}" value="12">/<input type="text" id="kit-form-delivery_year" class="crudit-ui-input crudit-ui-input--year" inputmode="numeric" aria-label="{{ 'crudit_ui.form.date.year'|trans({}, 'LleCruditUiBundle') }}" value="2026">
            </div>
        </fieldset>

        <fieldset class="crudit-ui-field crudit-ui-field__group">
            <legend class="crudit-ui-label">Channels</legend>
            <ul class="crudit-ui-check-list">
                <li><label class="crudit-ui-check"><input type="checkbox" class="crudit-ui-check__input" checked><span class="crudit-ui-check__label">Mail</span></label></li>
                <li><label class="crudit-ui-check"><input type="checkbox" class="crudit-ui-check__input"><span class="crudit-ui-check__label">Phone</span></label></li>
                <li><label class="crudit-ui-check"><input type="checkbox" class="crudit-ui-check__input" disabled><span class="crudit-ui-check__label">Fax (disabled)</span></label></li>
            </ul>
        </fieldset>

        <fieldset class="crudit-ui-field crudit-ui-field__group">
            <legend class="crudit-ui-label">Priority</legend>
            <ul class="crudit-ui-check-list">
                <li><label class="crudit-ui-check"><input type="radio" name="kit-form-priority" class="crudit-ui-check__input" checked><span class="crudit-ui-check__label">Normal</span></label></li>
                <li><label class="crudit-ui-check"><input type="radio" name="kit-form-priority" class="crudit-ui-check__input"><span class="crudit-ui-check__label">Urgent</span></label></li>
            </ul>
        </fieldset>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-zones" class="crudit-ui-label">Zones (list with search, several answers)</label>
            </div>
            {{ include('@LleCruditUi/form/_combobox.html.twig', {
                id: 'kit-form-zones',
                name: 'zones[]',
                label: 'Zones',
                multiple: true,
                attr: {'aria-describedby': 'kit-form-zones_help'},
                options: [
                    {value: 'n', label: 'North'}, {value: 's', label: 'South'}, {value: 'e', label: 'East'},
                    {value: 'w', label: 'West'}, {value: 'c', label: 'Centre'}, {value: 'mtn', label: 'Mountains (Vosges)'},
                    {value: 'cst', label: 'Côte d’Azur'},
                ],
                selected: [{value: 's', label: 'South'}],
            }, with_context: false) }}
            <p id="kit-form-zones_help" class="crudit-ui-help">Type to filter, Enter to add, Backspace to remove the last one.</p>
        </div>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-sites" class="crudit-ui-label">Sites (a closed site stays, it cannot be removed)</label>
            </div>
            {{ include('@LleCruditUi/form/_combobox.html.twig', {
                id: 'kit-form-sites',
                name: 'sites[]',
                label: 'Sites',
                multiple: true,
                options: [
                    {value: 'epi', label: 'Épinal'}, {value: 'nan', label: 'Nancy'},
                    {value: 'mul', label: 'Mulhouse (closed)', disabled: true}, {value: 'col', label: 'Colmar (closed)', disabled: true},
                ],
                selected: [{value: 'mul', label: 'Mulhouse (closed)', disabled: true}, {value: 'epi', label: 'Épinal'}],
            }, with_context: false) }}
        </div>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-client" class="crudit-ui-label">Client (list with search, from the server)</label>
            </div>
            {{ include('@LleCruditUi/form/_combobox.html.twig', {
                id: 'kit-form-client',
                name: 'client',
                label: 'Client',
                url: path('crudit_ui_kit_choices'),
                attr: {'aria-required': 'true'},
                selected: [{value: '1', label: 'Garage de Épinal 1'}],
            }, with_context: false) }}
        </div>

        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-active" class="crudit-ui-label">Active</label>
            </div>
            <label class="crudit-ui-switch">
                <input type="checkbox" role="switch" id="kit-form-active" class="crudit-ui-switch__input" checked>
                <span class="crudit-ui-switch__state crudit-ui-switch__state--on" aria-hidden="true">{{ 'crudit_ui.boolean.yes'|trans({}, 'LleCruditUiBundle') }}</span>
                <span class="crudit-ui-switch__state crudit-ui-switch__state--off" aria-hidden="true">{{ 'crudit_ui.boolean.no'|trans({}, 'LleCruditUiBundle') }}</span>
            </label>
        </div>

        <div class="crudit-ui-field">
            <label class="crudit-ui-check"><input type="checkbox" id="kit-form-terms" class="crudit-ui-check__input"><span class="crudit-ui-check__label">Send a copy to the customer</span></label>
        </div>

        {#- File: a drop zone covered by the true input; the file already sent with its preview, Download and Delete -#}
        <div class="crudit-ui-field">
            <div class="crudit-ui-field__label-row">
                <label for="kit-form-file" class="crudit-ui-label">Photo</label>
            </div>
            {{ include('@LleCruditUi/form/_file.html.twig', {
                input: '<input type="file" id="kit-form-file" name="photo" class="crudit-ui-file__input" accept="image/*" aria-describedby="kit-form-file_help">',
                current: {
                    name: 'front-of-the-shop.svg',
                    size: 1843,
                    download: 'data:image/svg+xml,' ~ kit_photo|url_encode,
                    preview: 'data:image/svg+xml,' ~ kit_photo|url_encode,
                },
                delete: 'photo_delete',
            }, with_context: false) }}
            <div id="kit-form-file_help" class="crudit-ui-help">An image, 2 MB at most.</div>
        </div>

        {#- Collection with an order: the markup of the block collection_widget of the form theme (sortable) -#}
        <fieldset class="crudit-ui-field crudit-ui-field__group">
            <legend class="crudit-ui-label">Parts</legend>
            {%- set kit_controller = '2lenet--crudit-ui-bundle--collection' -%}
            {%- set kit_domain = 'LleCruditUiBundle' -%}
            {%- set kit_parts = [{part: 'Pump', quantity: 2}, {part: 'Valve', quantity: 1}, {part: 'Seal', quantity: 4}] -%}
            <div id="kit-form-parts" class="crudit-ui-collection" data-controller="{{ kit_controller }}"
                data-{{ kit_controller }}-entry-value="{{ 'crudit_ui.collection.entry'|trans({}, kit_domain) }}"
                data-{{ kit_controller }}-index-value="{{ kit_parts|length }}"
                data-{{ kit_controller }}-prototype-name-value="__name__"
                data-{{ kit_controller }}-sortable-value="true"
                data-{{ kit_controller }}-move-up-text-value="{{ 'crudit_ui.collection.move_up'|trans({}, kit_domain) }}"
                data-{{ kit_controller }}-move-down-text-value="{{ 'crudit_ui.collection.move_down'|trans({}, kit_domain) }}"
                data-{{ kit_controller }}-remove-text-value="{{ 'crudit_ui.collection.remove'|trans({}, kit_domain) }}"
                data-{{ kit_controller }}-added-text-value="{{ 'crudit_ui.collection.added'|trans({}, kit_domain) }}"
                data-{{ kit_controller }}-removed-text-value="{{ 'crudit_ui.collection.removed'|trans({}, kit_domain) }}"
                data-{{ kit_controller }}-moved-text-value="{{ 'crudit_ui.collection.moved'|trans({}, kit_domain) }}"
            >
                <p class="crudit-ui-collection__empty" hidden data-{{ kit_controller }}-target="empty">{{ 'crudit_ui.collection.empty'|trans({}, kit_domain) }}</p>
                <ol class="crudit-ui-collection__rows" data-{{ kit_controller }}-target="rows">
                    {%- for kit_part in kit_parts -%}
                        {{- _self.part_row(kit_part, loop.index0, loop.index, loop.first, loop.last) -}}
                    {%- endfor -%}
                </ol>
                <template data-{{ kit_controller }}-target="prototype">{{ _self.part_row(null, '__name__', '__name__', false, false) }}</template>
                <button type="button" class="crudit-ui-btn crudit-ui-btn--secondary crudit-ui-btn--small crudit-ui-collection__add" aria-label="{{ 'crudit_ui.collection.add_to'|trans({'%label%': 'Parts'}, kit_domain) }}"
                    data-{{ kit_controller }}-target="add" data-action="{{ kit_controller }}#add">
                    {{- ui_icon('add') -}}{{ 'crudit_ui.collection.add'|trans({}, kit_domain) }}
                </button>
                <p class="crudit-ui-visually-hidden" role="status" aria-live="polite" data-{{ kit_controller }}-target="status"></p>
            </div>
        </fieldset>
    </div>
</form>

{#- A line of the collection Parts of the kit (kit_part null: the prototype, number and key __name__) -#}
{%- macro part_row(kit_part, kit_key, kit_number, kit_first, kit_last) -%}
    {%- set kit_controller = '2lenet--crudit-ui-bundle--collection' -%}
    {%- set kit_domain = 'LleCruditUiBundle' -%}
    {%- set kit_name = 'crudit_ui.collection.entry'|trans({'%index%': kit_number}, kit_domain) -%}
    <li class="crudit-ui-collection__row" aria-label="{{ kit_name }}" data-{{ kit_controller }}-target="row">
        <span class="crudit-ui-collection__index" aria-hidden="true" data-crudit-ui-collection-index>{{ kit_number }}</span>
        <div class="crudit-ui-collection__fields">
            <div class="crudit-ui-field">
                <div class="crudit-ui-field__label-row">
                    <label for="kit-form-parts_{{ kit_key }}_part" class="crudit-ui-label">Part<span class="crudit-ui-visually-hidden" data-crudit-ui-collection-entry-name>, {{ kit_name }}</span></label>
                </div>
                <input type="text" id="kit-form-parts_{{ kit_key }}_part" name="parts[{{ kit_key }}][part]" class="crudit-ui-input" value="{{ kit_part.part ?? '' }}">
            </div>
            <div class="crudit-ui-field">
                <div class="crudit-ui-field__label-row">
                    <label for="kit-form-parts_{{ kit_key }}_quantity" class="crudit-ui-label">Quantity<span class="crudit-ui-visually-hidden" data-crudit-ui-collection-entry-name>, {{ kit_name }}</span></label>
                </div>
                <input type="number" id="kit-form-parts_{{ kit_key }}_quantity" name="parts[{{ kit_key }}][quantity]" class="crudit-ui-input" min="1" inputmode="numeric" value="{{ kit_part.quantity ?? '' }}">
            </div>
            <input type="hidden" name="parts[{{ kit_key }}][position]" value="{{ kit_part is null ? '' : kit_number }}" data-crudit-ui-collection-position>
        </div>
        <div class="crudit-ui-collection__actions">
            <button type="button" class="crudit-ui-icon-btn crudit-ui-icon-btn--small"{% if kit_first %} disabled{% endif %} data-crudit-ui-collection-up data-action="{{ kit_controller }}#moveUp">
                {{- ui_icon('arrow-up') -}}<span class="crudit-ui-visually-hidden" data-crudit-ui-collection-text="moveUp">{{ 'crudit_ui.collection.move_up'|trans({'%item%': kit_name}, kit_domain) }}</span>
            </button>
            <button type="button" class="crudit-ui-icon-btn crudit-ui-icon-btn--small"{% if kit_last %} disabled{% endif %} data-crudit-ui-collection-down data-action="{{ kit_controller }}#moveDown">
                {{- ui_icon('arrow-down') -}}<span class="crudit-ui-visually-hidden" data-crudit-ui-collection-text="moveDown">{{ 'crudit_ui.collection.move_down'|trans({'%item%': kit_name}, kit_domain) }}</span>
            </button>
            <button type="button" class="crudit-ui-icon-btn crudit-ui-icon-btn--small crudit-ui-collection__remove" data-crudit-ui-collection-remove data-action="{{ kit_controller }}#remove">
                {{- ui_icon('delete') -}}<span class="crudit-ui-visually-hidden" data-crudit-ui-collection-text="remove">{{ 'crudit_ui.collection.remove'|trans({'%item%': kit_name}, kit_domain) }}</span>
            </button>
        </div>
    </li>
{%- endmacro -%}
