{
    "name": "@2lenet/crudit-ui-bundle",
    "description": "2LE design system: Stimulus controllers and compiled CSS",
    "version": "0.1.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "symfony": {
        "controllers": {
            "alert": {
                "main": "dist/controllers/alert_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "button": {
                "main": "dist/controllers/button_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "dialog": {
                "main": "dist/controllers/dialog_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "disclosure": {
                "main": "dist/controllers/disclosure_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "dropdown": {
                "main": "dist/controllers/dropdown_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "tabs": {
                "main": "dist/controllers/tabs_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "theme": {
                "main": "dist/controllers/theme_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            },
            "tooltip": {
                "main": "dist/controllers/tooltip_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0"
    },
    "devDependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "@iconify-json/bi": "^1.2.7",
        "@iconify-json/bx": "^1.2.3",
        "@iconify-json/fa7-regular": "^1.2.3",
        "@iconify-json/fa7-solid": "^1.2.5",
        "@iconify-json/flowbite": "^1.2.7",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/iconoir": "^1.2.12",
        "@iconify-json/ion": "^1.2.7",
        "@iconify-json/lucide": "^1.2.143",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/octicon": "^1.2.38",
        "@iconify-json/ph": "^1.2.2",
        "@iconify-json/tabler": "^1.2.42",
        "sass": "^1.80.0"
    },
    "scripts": {
        "build": "sass --no-source-map --style=compressed styles/ui.scss:dist/ui.css",
        "watch": "sass --no-source-map --watch styles/ui.scss:dist/ui.css",
        "test": "node --test tests/*.test.mjs",
        "check": "node scripts/check-build.mjs"
    }
}
