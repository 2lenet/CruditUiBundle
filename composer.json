{
    "name": "2lenet/crudit-ui-bundle",
    "type": "symfony-bundle",
    "description": "2LE design system: tokens, base CSS, Twig components and Stimulus controllers shared by the 2LE bundles.",
    "keywords": [
        "symfony-ux",
        "design-system",
        "twig-component",
        "stimulus"
    ],
    "license": "MIT",
    "homepage": "https://github.com/2lenet/CruditUiBundle",
    "authors": [
        {
            "name": "Project Contributors",
            "homepage": "https://github.com/2lenet/CruditUiBundle/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0",
        "symfony/stimulus-bundle": "^2.20 || ^3.0",
        "symfony/translation": "^7.0 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/ux-icons": "^3.4",
        "symfony/ux-twig-component": "^2.20 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "slevomat/coding-standard": "^8.13",
        "squizlabs/php_codesniffer": "^3.7",
        "symfony/asset-mapper": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Lle\\CruditUiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lle\\CruditUiBundle\\Tests\\": "tests/phpunit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
