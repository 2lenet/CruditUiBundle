{% extends 'base.html.twig' %}

{% block title %}CruditUiBundle AssetMapper test{% endblock %}

{% block body %}
    <h1>CruditUiBundle AssetMapper test</h1>
    <div {{ stimulus_controller('@2lenet/crudit-ui-bundle/dropdown') }} {{ stimulus_action('@2lenet/crudit-ui-bundle/dropdown', 'keydown', 'keydown') }}>
        <button type="button" class="crudit-ui-dropdown__button" aria-expanded="false" {{ stimulus_target('@2lenet/crudit-ui-bundle/dropdown', 'button') }} {{ stimulus_action('@2lenet/crudit-ui-bundle/dropdown', 'toggle') }}>Menu</button>
        <div hidden {{ stimulus_target('@2lenet/crudit-ui-bundle/dropdown', 'panel') }}>Panel</div>
    </div>
    <a href="#" class="btn">Bootstrap button</a>
    {% set ui_theme_controller = '@2lenet/crudit-ui-bundle/theme' %}
    <div role="group" aria-label="{{ 'crudit_ui.theme.label'|trans(domain: 'LleCruditUiBundle') }}" {{ stimulus_controller(ui_theme_controller) }}>
        {% for theme in ['light', 'dark', 'system'] %}
            <button type="button" value="{{ theme }}" {{ stimulus_target(ui_theme_controller, 'option') }} {{ stimulus_action(ui_theme_controller, 'choose') }}>{{ ('crudit_ui.theme.' ~ theme)|trans(domain: 'LleCruditUiBundle') }}</button>
        {% endfor %}
    </div>
    <section aria-label="{{ 'crudit_ui.language.label'|trans(domain: 'LleCruditUiBundle') }}">
        <p>
            {% for locale in ['fr', 'en', 'de', 'ar_SA', 'ar_MA', 'fa'] %}
                <a href="{{ path('home_locale', {_locale: locale}) }}" hreflang="{{ locale|replace({'_': '-'}) }}">{{ locale }}</a>
            {% endfor %}
        </p>
        <p>
            <output id="number">{{ 1234.5|ui_number }}</output>
            <output id="date">{{ '2026-10-13 12:00'|ui_date('short') }}</output>
            {# directional icon: ui_icon() gives it the mirror modifier #}
            <svg id="mirrored" class="crudit-ui-icon crudit-ui-icon--mirror" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h10M8 4l4 4-4 4"/></svg>
        </p>
    </section>
{% endblock %}
