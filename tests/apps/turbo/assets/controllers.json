{
    "controllers": {
        "@2lenet/crudit-ui-bundle": {
            "alert": {
                "enabled": true,
                "fetch": "eager"
            },
            "button": {
                "enabled": true,
                "fetch": "eager"
            },
            "command-palette": {
                "enabled": true,
                "fetch": "eager"
            },
            "dialog": {
                "enabled": true,
                "fetch": "eager"
            },
            "disclosure": {
                "enabled": true,
                "fetch": "eager"
            },
            "dropdown": {
                "enabled": true,
                "fetch": "eager"
            },
            "table": {
                "enabled": true,
                "fetch": "eager"
            },
            "table-sort": {
                "enabled": true,
                "fetch": "lazy"
            },
            "tabs": {
                "enabled": true,
                "fetch": "eager"
            },
            "theme": {
                "enabled": true,
                "fetch": "eager"
            },
            "toasts": {
                "enabled": true,
                "fetch": "eager"
            },
            "tooltip": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@symfony/ux-turbo": {
